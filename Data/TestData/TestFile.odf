# all values (even ones in components) are optional 
[GameObject]
{
    layer(std::string|"Default")
    is_active(bool|true)
    is_drawn(bool|true)
    [Transform]
    {
        position(sf::Vector2f|{0,0})
        scale(sf::Vector2f|{2,2})
        z_height({float|20})
    }
    [Components]
    {
        [Component(Animator)]
        {
            Animations(std::vector<std::string>|Player/Idle, Player/Walk, Player/Jump)
        }
        [Script(MovementScript)]
        {
            Speed(float|10.0)
            JumpPower(float|5.0)
        }
        [Script(HealthManager)]
        {
            Health(float|100.0)
	        Resistance(float|30.0)
        }
    }
    [Children]
    {
        [GameObject(Sword)]
        {
            layer(std::string|"Default")
            is_active(bool|true)
            is_drawn(bool|true)
            [Transform]
            {
                position(sf::Vector2f|{0,0})
                scale(sf::Vector2f|{2,2})
                z_height({float|20})
            }
            [Components]
            {
                [Component(Animator)]
                {
                    animations(std::vector<std::string>|Player/Idle, Player/Walk, Player/Jump)
                }
                [Script(Attacker)]
                {
                    speed(float|10.0)
                    damage(float|20.0)
                }
                [Script(DurabilityManager)]
                {
                    durability(float|100.0)
                }
            }
        }
    }
}