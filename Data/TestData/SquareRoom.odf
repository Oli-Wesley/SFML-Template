[Room]
{
    RoomSize(sf::Vector2i|{17,17})
    RoomPrefab(std::string|"P_SquareRoom")
    
    # can be used as a room to start the player in?
    IsStartRoom(bool|false)
    StartPosition(sf::Vector2i|{7,7})

    # exits: Directions = N,E,S,W
    [Exits]{
        [Exit]{
            ExitPosition(sf::Vector2i|{3,0}) 
            ExitDirection(char|'N')
        }
        [Exit]{
            ExitPosition(sf::Vector2i|{16, 11})
            ExitDirection(char|'E')
        }
        [Exit]{
            ExitPosition(sf::Vector2i|{13, 16})
            ExitDirection(char|'S')
        }
        [Exit]{
            ExitPosition(sf::Vector2i|{0, 11})
            ExitDirection(char|'W')
        }
    }
}