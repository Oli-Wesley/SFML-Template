[Room]
{
    RoomSize(17,17)
    RoomPrefab(P_SquareRoom)
    
    # can be used as a room to start the player in?
    IsStartRoom(false)
    StartPosition(7,7)

    # exits: Directions = N,E,S,W
    [Exits]{
        [Exit]{
            ExitPosition(3,0) 
            ExitDirection(N)
        }
        [Exit]{
            ExitPosition(16, 11)
            ExitDirection(E)
        }
        [Exit]{
            ExitPosition(13, 16)
            ExitDirection(S)
        }
        [Exit]{
            ExitPosition(0, 11)
            ExitDirection(W)
        }
    }
}